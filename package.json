{
  "name": "wenshan",
  "version": "1.0.0",
  "private": true,
  "description": "问山：面向地理野外实习的开源知识库，支持资料导入、知识图谱、路线回放和带来源的现场问答。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "wenshan": "bin/wenshan.mjs"
  },
  "scripts": {
    "start": "node bin/wenshan.mjs start",
    "setup": "node bin/wenshan.mjs install",
    "doctor": "node bin/wenshan.mjs doctor",
    "data": "node bin/wenshan.mjs data",
    "terrain": "node bin/wenshan.mjs terrain",
    "eval": "node bin/wenshan.mjs eval",
    "test": "node tests/store.test.mjs && node tests/cli.test.mjs && node tests/ops.test.mjs && node tests/build.test.mjs",
    "test:integration": "node tests/smoke.test.mjs && node tests/product.test.mjs",
    "preflight": "node bin/wenshan.mjs preflight",
    "backup": "node bin/wenshan.mjs backup",
    "restore": "node bin/wenshan.mjs restore",
    "health": "node bin/wenshan.mjs health",
    "test:ops": "node tests/ops.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuedai-mayi/wenshan.git"
  },
  "keywords": [
    "geo-rag",
    "knowledge-graph",
    "field-trip",
    "education",
    "agent",
    "llm",
    "wenshan",
    "gis"
  ],
  "homepage": "https://github.com/xuedai-mayi/wenshan#readme",
  "bugs": {
    "url": "https://github.com/xuedai-mayi/wenshan/issues"
  }
}
